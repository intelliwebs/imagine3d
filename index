            // Loading State
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Guardando Consulta...`;

            try {
                // Post JSON data to Google Apps Script Endpoint
                await fetch(SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                showToast("¡Consulta guardada correctamente! Te responderemos muy pronto.");
                document.getElementById('inquiry-form').reset();
            } catch (error) {
                console.error("Error al enviar:", error);
                showToast("Error al conectar con la planilla, intentando vía WhatsApp...");
                sendFormViaWhatsApp();
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            }
        }

